# cp .env.example .env 후 값을 채우세요. .env 는 git 에 올리지 않습니다.
# 비밀값 생성 예:  openssl rand -base64 32   /   openssl rand -hex 16

POSTGRES_PASSWORD=
JARION_DB_PASSWORD=
JARION_JWT_SECRET=
# 반드시 32자리 hex (openssl rand -hex 16)
GUAC_JSON_SECRET_KEY=
# WoL 릴레이(tools/wol/relay.py)의 RELAY_TOKEN 과 같은 값, 16자 이상
RELAY_TOKEN=

# 세션 정책
SESSION_MAX_MINUTES=240
NO_SHOW_MINUTES=15
ALLOW_CLIPBOARD_COPY=true
ALLOW_CLIPBOARD_PASTE=true
RECORDING_ENABLED=false

# RDP 로그인: 학교 AD 도메인 (예: SCHOOL). 포털 아이디 = AD 아이디면 RDP_PREFILL_USERNAME=true
RDP_DOMAIN=
RDP_PREFILL_USERNAME=false

# PC 에이전트 (agent/)
# 모든 PC 공통 등록 키. 비워 두면 에이전트 등록 불가. openssl rand -base64 32
AGENT_ENROLLMENT_KEY=
# 자동 로그오프에서 제외할 계정 (IT 관리자 원격 점검용), 쉼표 구분. 예: itadmin,SCHOOL\labadmin
AGENT_EXEMPT_USERS=
AGENT_WATCH_PROCESSES=Revit.exe,midas*.exe,acad.exe
# 종료 몇 분 전에 원격 화면에 안내
EXPIRY_WARNING_MINUTES=10
# 브라우저를 닫아 연결만 끊긴 상태가 이만큼 지속되면 자동 반납
REMOTE_DISCONNECTED_GRACE_MINUTES=15
# 아무도 안 쓰는 PC 를 이 시간(분) 뒤 자동 종료. 0 = 사용 안 함
IDLE_SHUTDOWN_MINUTES=0

GUACAMOLE_VERSION=1.5.5
HTTP_PORT=80
HTTPS_PORT=443
