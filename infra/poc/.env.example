# cp .env.example .env 후 값을 바꾸세요. .env 는 git 에 올리지 않습니다.

GUACAMOLE_VERSION=1.5.5

POSTGRES_DB=guacamole_db
POSTGRES_USER=guacamole_user
# 반드시 긴 임의 문자열로 변경 (예: openssl rand -base64 24)
POSTGRES_PASSWORD=change-me

# 2단계 인증(TOTP). 학교 SSO 연동 전 PoC 에서도 켜 두는 것을 권장
TOTP_ENABLED=true

HTTP_PORT=80
HTTPS_PORT=443
